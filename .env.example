# Copia este archivo como .env y completa los valores
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env  (Windows)

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos
# Con Docker usa los valores de abajo (coinciden con docker-compose.yml)
# Para SQLite pon: USE_SQLITE=True y el resto no importa
USE_SQLITE=False
DB_NAME=libreria_db
DB_USER=libreria_user
DB_PASSWORD=libreria_pass
DB_HOST=db
DB_PORT=3306
